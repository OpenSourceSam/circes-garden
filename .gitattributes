# Normalise line endings in text files; keep binaries untouched.
* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ogg binary
*.mp3 binary
*.wav binary
*.wasm binary
*.pck binary
*.aseprite binary
*.pdf binary
*.zip binary
